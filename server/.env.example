# Environment variables for server

# Server config
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# SSL certificates (paths relative to server/)
SSL_CERT_PATH=./certs/localhost+2.pem
SSL_KEY_PATH=./certs/localhost+2-key.pem

# Socket.io config
PING_TIMEOUT=20000
PING_INTERVAL=25000
CORS_ORIGIN=https://localhost:5173
