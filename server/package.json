{
  "name": "video-chat-server",
  "version": "1.0.0",
  "description": "WebRTC video chat server with Socket.io signaling",
  "main": "src/server.js",
  "type": "module",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "start": "node src/server.js",
    "start:prod": "cross-env NODE_ENV=production node src/server.js",
    "dev": "node --watch src/server.js",
    "build:client": "npm --prefix ../client run build",
    "build": "npm run build:client",
    "serve": "npm run build && npm run start:prod",
    "test": "vitest"
  },
  "keywords": [
    "webrtc",
    "video-chat",
    "socket.io"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "isomorphic-dompurify": "^4.2.0",
    "socket.io": "^4.8.3",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "socket.io-client": "^4.8.3",
    "vitest": "^5.0.1"
  }
}
